{
  // Static site: the whole repo root is served as assets, minus the files listed
  // in .assetsignore. Named to match the existing Worker so previews attach to it.
  "name": "sqshah-com",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": ".",
    // unknown paths get the real 404 page, with a 404 status
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  // required by `wrangler preview`; empty means previews inherit production settings
  "previews": {}
}
